{
    "name": "unero/identity-service",
    "description": "Unero Identity Service: authentication, authorization (RBAC), service accounts, API keys, sessions, and tokens for the Unero platform.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^12.60.0",
        "aws/aws-sdk-php": "^3.300",
        "guzzlehttp/guzzle": "^7.8",
        "open-telemetry/sdk": "^1.1",
        "open-telemetry/exporter-otlp": "^1.1",
        "predis/predis": "^2.2",
        "promphp/prometheus_client_php": "^2.11",
        "ramsey/uuid": "^4.7",
        "symfony/uid": "^7.2"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2.2",
        "larastan/larastan": "^3.0",
        "rector/rector": "^2.0",
        "phpunit/phpunit": "^11.5",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "laravel/pint": "^1.18",
        "infection/infection": "^0.29",
        "fakerphp/faker": "^1.23"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@php artisan package:discover --ansi"
        ],
        "test": "@php artisan test",
        "analyse": "phpstan analyse --memory-limit=512M",
        "pint": "pint --test",
        "pint:fix": "pint",
        "rector": "rector process --dry-run",
        "rector:fix": "rector process",
        "security": "@composer audit --no-interaction",
        "mutation": "infection --min-msi=80 --threads=4",
        "check": [
            "@pint",
            "@rector",
            "@analyse",
            "@test",
            "@security"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true,
            "php-http/discovery": true,
            "tbachert/spi": true
        },
        "platform": {
            "php": "8.3.0"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
