APP_NAME=identity-service
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

LOG_CHANNEL=stderr

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=identity_service
DB_USERNAME=unero
DB_PASSWORD=
DB_SCHEMA=identity

CACHE_STORE=redis
