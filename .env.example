REDIS_PORT=6379

QUEUE_CONNECTION=sync

AWS_REGION=af-south-1
EVENT_BUS_NAME=unero-dev

# Sibling platform repositories (foundation phase; see UNERO_LINKS.md)
UNERO_PLATFORM_TERRAFORM=https://github.com/nellyurh/unero-platform-terraform
